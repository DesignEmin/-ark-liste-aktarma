# ─────────────────────────────────────────────────────────────
# Müzik Listesi Aktarıcı — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Hiçbir anahtar istemciye gönderilmez (NEXT_PUBLIC_ öneki yok).
# ─────────────────────────────────────────────────────────────

# Uygulamanın dışarıdan erişilen tam adresi (sonunda / olmadan).
# Yerelde Spotify "localhost" kabul etmediği için 127.0.0.1 kullanın.
APP_URL=http://127.0.0.1:3000

# Çerez şifreleme anahtarı: en az 32 karakter rastgele değer.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# ── Spotify (https://developer.spotify.com/dashboard) ─────────
# Redirect URI: {APP_URL}/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── YouTube / Google (https://console.cloud.google.com) ───────
# Redirect URI: {APP_URL}/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Deezer (https://developers.deezer.com/myapps) ─────────────
# Redirect URI (Application domain): {APP_URL}/api/auth/deezer/callback
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# ── Apple Music (https://developer.apple.com/account) ─────────
# Ücretli Apple Developer Program üyeliği gerekir.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 dosyasının içeriği. Satır sonlarını \n olarak yazabilirsiniz:
# "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=
# Katalog aramalarında kullanılacak varsayılan mağaza (ülke kodu).
# Kullanıcının kendi mağazası girişten sonra otomatik alınır.
APPLE_DEFAULT_STOREFRONT=tr
